{
  "manifest_version": 3,
  "name": "AI Stylist",
  "version": "1.0",
  "description": "Your personal AI stylist for virtual try-on and outfit search.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open AI Stylist"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}
